# Copy to .env on the server (chmod 600). Never commit .env.

# CDOT COtrip API key from manage-api.cotrip.org. Roads tile shows "No current data" without it.
CDOT_API_KEY=

# NWS asks API users to identify themselves with contact info in the User-Agent.
USER_AGENT=TellurideBuzz/0.1 (+https://telluride.buzz; telluridebuzz@gmail.com)

# Admin at /admin (towns, sources, health board). At least 10 characters; leave empty to turn the admin off.
# You can change the password later on the admin's Admin settings page; editing this line
# afterwards (and recreating the container) makes this one the password again.
ADMIN_PASSWORD=

# Visit counts with the self-hosted Umami (no cookies). Website ID from Umami's admin;
# leave empty to turn analytics off. One website covers every town (filter by hostname or tag).
UMAMI_WEBSITE_ID=
# Where the app reaches Umami (default: the umami container on the shared Docker network).
# UMAMI_URL=http://umami:3000
# The admin's "Analytics" link opens this.
# UMAMI_DASHBOARD_URL=https://analytics.meander.me
