# Add to the existing Caddyfile in /opt/meander.me/infra, then reload Caddy.
# Pilot hostname (no domain needed): replace 1.2.3.4 with the server's IPv4.
buzz.1.2.3.4.sslip.io {
	encode zstd gzip
	reverse_proxy telluride-buzz:3000
}

# Later, once the domain points at the server:
# telluride.buzz, www.telluride.buzz {
# 	encode zstd gzip
# 	reverse_proxy telluride-buzz:3000
# }

# Other towns run in the same container; the app picks the town from the hostname
# (set per town in the admin). Either add each town's address to Caddy, or set up the
# wildcard once (deploy/PHASE1.md) so new *.thetown.buzz towns need no server change:
# durango.thetown.buzz {
# 	encode zstd gzip
# 	reverse_proxy telluride-buzz:3000
# }
